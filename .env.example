# ── Qikink (Live print-on-demand) ────────────────────────────────
# Dashboard → Integration → Custom API
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
# "live" (default) or "sandbox"
QIKINK_ENV=live

# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for writes from API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Razorpay checkout (all server-only) ────────────────────────────
# Start with Test Mode keys. Live keys are rejected unless mode is live.
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
# Leave blank until ready to accept real payments. Filling these alone does not
# activate them: RAZORPAY_MODE must explicitly be changed to live.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
# A separate random secret chosen when adding the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=
