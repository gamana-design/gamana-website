# ── Qikink (Live print-on-demand) ────────────────────────────────
# Dashboard → Integration → Custom API
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
# "live" (default) or "sandbox"
QIKINK_ENV=live

# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for writes from API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
